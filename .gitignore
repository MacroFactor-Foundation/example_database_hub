outputs/

# Quarto: rendered site and caches (site/_variables.yml and site/generated/ ARE tracked)
site/_site/
site/.quarto/
.quarto/
*_files/
/.luarc.json

# Local configuration and secrets
.Renviron
.env
CLAUDE.local.md
.claude/settings.local.json

