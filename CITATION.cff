    family-names: Steele
  - given-names: Zac
    family-names: Robinson
  - given-names: Josh
    family-names: Pelland
  - given-names: Greg
    family-names: Nuckols
version: "data-v1.0.0"
date-released: "2026-09-23"
repository-code: "https://github.com/MacroFactor-Foundation/example_database_hub"
url: "https://macrofactor-foundation.github.io/example_database_hub/"
license:
  - MIT
  - CC-BY-4.0
keywords:
  - living database
  - resistance training
  - meta-analysis
  - synthetic data
# version and date-released are updated before each data release is tagged.
# No DOI: this synthetic example is not deposited on Zenodo.
